# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Public Browser Configuration (safe to expose to client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Server-Only Secret (NEVER expose with VITE_ prefix)
# Required for 24-hour attachment Storage deletion & admin emoji seeding
SUPABASE_SERVICE_ROLE_KEY=

# WebRTC TURN Server Configuration (Server-side only; issued via /api/ice-servers)
# Supports static credentials OR HMAC time-limited credentials (coturn use-auth-secret)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_STATIC_SECRET=

# Scheduled cleanup route bearer secret
CRON_SECRET=
